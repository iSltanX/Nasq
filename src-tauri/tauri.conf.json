{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nasaq",
  "version": "27.0.0",
  "identifier": "com.nasaq.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/iSltanX/Nasaq/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNTYzMkNGRDFEMjI5OUYKUldTZktkTFJ6ekpXSG1aYTZ6czIrczkzcjNRR0p0S1NRdjNsYkxXUFUyN2ZHRUlnUm11RGlnTW8K"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  }
}
