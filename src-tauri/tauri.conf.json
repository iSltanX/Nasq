{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nasaq",
  "version": "9.0.0",
  "identifier": "com.nasaq.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "نَسَق",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/iSltanX/Nasq/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNTYzMkNGRDFEMjI5OUYKUldTZktkTFJ6ekpXSG1aYTZ6czIrczkzcjNRR0p0S1NRdjNsYkxXUFUyN2ZHRUlnUm11RGlnTW8K"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
