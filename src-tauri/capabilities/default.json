{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "قدرات النافذة الرئيسية",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "process:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/*"
        }
      ]
    }
  ]
}
