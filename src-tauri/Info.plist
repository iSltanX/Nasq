<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- الأيقونة الحديثة من Assets.car (tools/icon/build-app-icon.sh)، وicon.icns احتياط الأنظمة الأقدم -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- فحص m7-05 وm7-11: بلا هذا يعامل النظامُ الحزمةَ تطبيقًا إنجليزيًا، فتأتي بنود القائمة
	     النظامية (Hide/Quit/Services) ونوافذ الفتح والحفظ بالإنجليزية، واتجاه النافذة يتبع لغة
	     النظام لا التطبيق. التطبيق عربيّ وحده: فالاتجاه من اليمين دائمًا، وإشارات النافذة يمينًا -->
	<key>CFBundleDevelopmentRegion</key>
	<string>ar</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
	</array>
</dict>
</plist>
